# Development only. Generate ignored local credentials; never use for production.
POSTGRES_DB=fitlink
POSTGRES_USER=fitlink
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
STORAGE_BACKEND=fake
# Production requires explicit settings module, >=50-character random secret,
# concrete hosts, verify-full PostgreSQL TLS, authenticated rediss dependencies,
# HTTPS private S3 and dedicated app credentials. Django never auto-loads dotenv.
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2
CHANNEL_REDIS_URL=redis://127.0.0.1:6380/3
OTP_RATE_REDIS_URL=redis://127.0.0.1:6380/4
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET_NAME=fitlink-private
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# C02 development uses a public test ring when unset; production requires
# environment-only base64 key material (>=32 bytes/key, at most three IDs).
# Never place production key material in this file.
AUTH_ENTRY_ENABLED=true
STAFF_RECOVERY_ENABLED=false
SMS_PROVIDER=mock
STAFF_STEP_UP_PROVIDER=disabled
TRUSTED_PROXY_CIDRS=

# Recovery intake approved engineering defaults per day, independent of OTP quotas.
RECOVERY_INTAKE_PHONE_LIMIT=3
RECOVERY_INTAKE_IP_LIMIT=10
RECOVERY_INTAKE_WINDOW_SECONDS=86400
