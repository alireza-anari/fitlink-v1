# Development only. Generate ignored local credentials; never use for production.
POSTGRES_DB=fitlink
POSTGRES_USER=fitlink
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
STORAGE_BACKEND=fake
# Production requires explicit settings module, >=50-character random secret,
# concrete hosts, verify-full PostgreSQL TLS, authenticated rediss dependencies,
# HTTPS private S3 and dedicated app credentials. Django never auto-loads dotenv.
